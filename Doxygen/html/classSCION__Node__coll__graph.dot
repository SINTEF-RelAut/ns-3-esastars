digraph "SCION_Node"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="SCION_Node",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="This is the base definition of a SCION enabled Node. A SCION_Node models an Autonomous System."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="ns3::Node",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" strategy" ,fontname="Helvetica"];
  Node3 [label="BeaconingStrategy",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBeaconingStrategy.html",tooltip=" "];
}
