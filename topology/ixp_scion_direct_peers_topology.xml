<!-- Direct-peer SCION topology: no IXP satellites.
     AS102-105 are interconnected by direct peer links matching the IF IDs used
     in the SCION direct-mode gateway-switch event files.

     IF ID encoding convention (from gen_direct_link_events.py):
       loc A: hundreds digit of last 3 digits = 1  (e.g. 1020100)
       loc B: hundreds digit of last 3 digits = 2  (e.g. 1020210)
       primary: units digit = 0 ; backup: units digit = 1

     Direct link mapping (full 6-pair mesh):
       gateway 1 → AS102-AS103 loc-A  (from_if_id primary=1020100, backup=1020101)
       gateway 2 → AS103-AS105 loc-A  (from_if_id primary=1030120, backup=1030121)
       gateway 3 → AS104-AS105 loc-B  (from_if_id primary=1040220, backup=1040221)
       gateway 4 → AS102-AS104 loc-B  (from_if_id primary=1020210, backup=1020211)
       gateway 5 → AS102-AS105 loc-B  (from_if_id primary=1020220, backup=1020221)
       gateway 6 → AS103-AS104 loc-A  (from_if_id primary=1030110, backup=1030111)

     Backbone direct core links: 101-102, 107-103, 105-106, 108-106, 104-108.
-->
<topology>
  <ases>
    <!-- Core backbone ASes -->
    <as id="101">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/></hosts>
    </as>
    <as id="102">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/><host id="3"/></hosts>
    </as>
    <as id="103">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/><host id="3"/></hosts>
    </as>
    <as id="104">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/><host id="3"/></hosts>
    </as>
    <as id="105">
      <property name="isd" value="1"/>
