      <hosts><host id="2"/><host id="3"/></hosts>
    </as>
    <as id="105">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/><host id="3"/></hosts>
    </as>
    <as id="106">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/></hosts>
    </as>
    <as id="107">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/></hosts>
    </as>
    <as id="108">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/></hosts>
    </as>
    <!-- Dual IXP satellites: represented as 110A (primary orbit) and 110B (backup orbit) -->
    <as id="120">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <property name="ixp_satellite" value="110A"/>
      <hosts><host id="2"/></hosts>
    </as>
    <as id="121">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <property name="ixp_satellite" value="110B"/>
      <hosts><host id="2"/></hosts>
    </as>
  </ases>

