<?xml version="1.0" encoding="UTF-8"?>
<!-- Dual-IXP-satellite topology: AS110 represented as two routing entities (110A, 110B)
     for distinct gateway attachment, but logically same AS for SCION beaconing.
     - No direct link between 110A and 110B.
     - Each satellite AS (102-105) connects to both 110A and 110B.
    - Backbone direct core links: 101-102, 107-103, 105-106, 108-106, and 104-108.
-->
<topology>
  <ases>
    <!-- Core backbone ASes -->
    <as id="101">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/></hosts>
    </as>
    <as id="102">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/><host id="3"/></hosts>
    </as>
    <as id="103">
      <property name="isd" value="1"/>
      <property name="type" value="core"/>
      <hosts><host id="2"/><host id="3"/></hosts>
    </as>
    <as id="104">
      <property name="isd" value="1"/>
